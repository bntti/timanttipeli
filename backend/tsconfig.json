{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noEmit": true,

        "strict": true,
        "noImplicitReturns": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
