{
    "compilerOptions": {
        // Lowest settings from frontend / backend
        "target": "es2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "strict": true
    },
    "include": ["src"]
}
